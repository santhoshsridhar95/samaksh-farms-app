{
  "name": "samaksh-farms-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:prod": "vite --mode production",
    "snapshot:public-content": "node scripts/generate-public-content-snapshot.mjs",
    "build": "node scripts/generate-public-content-snapshot.mjs && vite build",
    "build:dev": "vite build --mode development",
    "build:prod": "node scripts/generate-public-content-snapshot.mjs && vite build --mode production",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:prod": "vite preview --mode production",
    "mobile:env": "node scripts/prepare-mobile-env.mjs",
    "cap:sync": "node scripts/prepare-mobile-env.mjs && vite build --mode mobile && cap sync android",
    "cap:open:android": "cap open android",
    "android:debug": "node scripts/prepare-mobile-env.mjs && vite build --mode mobile && cap sync android && cd android && set \"JAVA_HOME=C:\\Program Files\\Java\\jdk-21_windows-x64_bin\\jdk-21.0.10\" && gradlew.bat assembleDebug",
    "android:release": "node scripts/prepare-mobile-env.mjs && vite build --mode mobile && cap sync android && cd android && set \"JAVA_HOME=C:\\Program Files\\Java\\jdk-21_windows-x64_bin\\jdk-21.0.10\" && gradlew.bat bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "axios": "^1.17.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.4"
  }
}
